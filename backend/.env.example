# Cloudflare Worker Environment Variables
# Copy this file to .dev.vars for local development
# Or set via `wrangler secret put VARIABLE_NAME`

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# M-Pesa (Safaricom)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
MPESA_CALLBACK_URL=https://your-worker.workers.dev/api/webhooks/mpesa

# PayHero
PAYHERO_API_KEY=your-payhero-api-key
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_CALLBACK_URL=https://your-worker.workers.dev/api/webhooks/payhero
