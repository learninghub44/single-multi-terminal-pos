# Cloudflare Worker Environment Variables
# Copy this file to .dev.vars for local development
# Or set via `wrangler secret put VARIABLE_NAME`

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# M-Pesa (Safaricom Daraja)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_PASSKEY=your-passkey
MPESA_SHORTCODE=your-shortcode
# Must end in the same random secret as MPESA_WEBHOOK_SECRET below - this is
# how the webhook endpoint tells a real Safaricom callback apart from a
# stranger who found the URL and is trying to fake a "payment successful".
MPESA_CALLBACK_URL=https://your-worker.workers.dev/api/webhooks/mpesa/CHANGE_ME_RANDOM_SECRET
MPESA_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET

# PayHero
# This must be the "Basic <token>" credential from your PayHero dashboard
# (Settings > API), not a raw username:password pair.
PAYHERO_API_KEY=your-payhero-basic-auth-token
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2
# Payment Channels > My Payment Channels in the PayHero dashboard - the
# till/paybill/bank account you want STK pushes to collect into.
PAYHERO_CHANNEL_ID=your-payhero-channel-id
PAYHERO_PROVIDER=m-pesa
PAYHERO_CALLBACK_URL=https://your-worker.workers.dev/api/webhooks/payhero/CHANGE_ME_RANDOM_SECRET_2
PAYHERO_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET_2
